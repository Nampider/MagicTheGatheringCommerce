SERVER_PORT=8084
SPRING_R2DBC_URL=r2dbc:postgresql://localhost:5433/commerce_db
SPRING_R2DBC_USERNAME=replace-with-local-postgres-user
SPRING_R2DBC_PASSWORD=replace-with-local-postgres-password
SPRING_FLYWAY_URL=jdbc:postgresql://localhost:5433/commerce_db
SPRING_FLYWAY_USER=replace-with-local-postgres-user
SPRING_FLYWAY_PASSWORD=replace-with-local-postgres-password
SPRING_FLYWAY_ENABLED=true
SPRING_FLYWAY_LOCATIONS=classpath:db/migration

KEYCLOAK_ISSUER_URL=http://localhost:8081/realms/cards
KEYCLOAK_JWK_SET_URI=http://localhost:8081/realms/cards/protocol/openid-connect/certs

COMMERCE_PAYMENT_PROVIDER=mock
COMMERCE_CURRENCY=usd
STRIPE_SECRET_KEY=replace-with-stripe-secret-key-or-leave-empty-for-mock
STRIPE_WEBHOOK_SECRET=replace-with-stripe-webhook-secret-or-leave-empty-for-mock

ACCOUNTS_SERVICE_URL=http://localhost:8082
MAGIC_WEBSITE_URL=http://localhost:8083
